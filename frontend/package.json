{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.anirom.app",
    "productName": "Anirom",
    "icon": "build/anirom-icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "bin/**/*"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run build:go && electron-vite build",
    "lint": "eslint",
    "test": "vitest",
    "postinstall": "node scripts/extract-mpv.js && node scripts/patch-electron-trpc.js",
    "build:go": "cd go-engine && go build -o ../bin/go-engine.exe",
    "build:electron": "npm run build && electron-builder"
  },
  "dependencies": {

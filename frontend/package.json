{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "com.anirom.app",
    "productName": "Anirom",
    "icon": "build/anirom-icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "bin/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "postinstall": "node scripts/extract-mpv.js",
    "build:go": "cd go-engine && go build -o ../bin/go-engine.exe",
    "electron": "wait-on tcp:3000 && set NODE_ENV=development&& electron .",
    "dev:electron": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "build:electron": "npm run build && npm run build:go && electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toast": "^1.2.20",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "https-proxy-agent": "^9.1.0",
    "next": "16.2.11",
    "next-font": "^2.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-player": "^3.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "webtorrent": "^3.0.16",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lucide-react": "^1.25.0",
    "node-7z": "^3.0.0",
    "postcss": "^8.5.21",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}

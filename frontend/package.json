    "@vitejs/plugin-react": "^6.0.5",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.25.0",
    "node-7z": "^3.0.0",
    "postcss": "^8.5.21",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4",
